ion":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7128"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7128"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44838,"date":"2026-09-15T11:52:56","date_gmt":"2026-09-15T16:52:56","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44838"},"modified":"2026-09-15T11:52:58","modified_gmt":"2026-09-15T16:52:58","slug":"elisabeth-haase-joe-udelhofen-and-kevin-dolge-receive-innovation-award-for-environmental-health-and-safety","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/elisabeth-haase-joe-udelhofen-and-kevin-dolge-receive-innovation-award-for-environmental-health-and-safety\/","title":{"rendered":"Elisabeth Haase, Joe Udelhofen, and Kevin Dolge receive innovation award for environmental health and safety"},"content":{"rendered":"\n<p>Elisabeth Haase, director of environmental health and safety compliance; Joe Udelhofen, environmental health and safety specialist and training coordinator; and Kevin Dolge, chemical hygiene\/radiation safety officer, were awarded the 2026 CSHEMA Process Improvement Innovation Award in collaboration with Pat Ceas from St. Olaf College and Margaret Smallbrock from South Dakota School of Mines. The project, \u201cAn Innovative Safety Training \u2013 Game-Based Learning Method,\u201d was presented at the 73rd Annual CSHEMA Conference in Austin, Texas.<\/p>\n\n\n\n<p><a href=\"https:\/\/www.cshema.org\/index.php\/about-us\/awards\">Learn more about CSHEMA awards.<\/a><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Haase, Udelhofen, and Dolge are all part of Environmental Health and Safety at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[7089,7196],"tags":[],"class_list":["post-44838","post","type-post","status-publish","format-standard","hentry","category-elsewhere","category-grants-awards"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44838","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44838"}],"version-history":[{"count":2,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44838\/revisions"}],"predecessor-version":[{"id":44840,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44838\/revisions\/44840"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44838"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44838"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44838"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7196,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/grants-awards\/","name":"Grants &amp; Awards","slug":"grants-awards","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7196","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7196"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7196"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44835,"date":"2026-09-15T11:48:04","date_gmt":"2026-09-15T16:48:04","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44835"},"modified":"2026-09-15T11:48:06","modified_gmt":"2026-09-15T16:48:06","slug":"professor-kate-meyer-09-publishes-climate-applications-for-the-college-mathematics-classroom","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/professor-kate-meyer-09-publishes-climate-applications-for-the-college-mathematics-classroom\/","title":{"rendered":"Professor Kate Meyer \u201909 publishes Climate Applications for the College Mathematics Classroom"},"content":{"rendered":"\n<p>Kate Meyer \u201909, assistant professor of mathematics, published <em>Climate Applications for the College Mathematics Classroom<\/em> with co-authors Kaitlin Hill (St. Mary\u2019s University) and Katherine Slyman (Boston College). This collection of climate modules and problem sets \u201cenable instructors to help students engage critically with climate-related topics while deepening and strengthening their mathematical skills.\u201d<\/p>\n\n\n\n<p><a href=\"https:\/\/bookstore.ams.org\/view?ProductCode=CLRM\/79\">Learn more about the textbook.<\/a><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Meyer is assistant professor of mathematics at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[75,7089],"tags":[],"class_list":["post-44835","post","type-post","status-publish","format-standard","hentry","category-alumni","category-elsewhere"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44835","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44835"}],"version-history":[{"count":2,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44835\/revisions"}],"predecessor-version":[{"id":44837,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44835\/revisions\/44837"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44835"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44835"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44835"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":75,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/alumni\/","name":"Alumni","slug":"alumni","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/75","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=75"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=75"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44824,"date":"2026-09-15T11:35:06","date_gmt":"2026-09-15T16:35:06","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44824"},"modified":"2026-09-15T11:35:07","modified_gmt":"2026-09-15T16:35:07","slug":"opening-convocation-2026-academic-year-features-governor-tim-walz-major-financial-aid-announcement","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/opening-convocation-2026-academic-year-features-governor-tim-walz-major-financial-aid-announcement\/","title":{"rendered":"Opening Convocation for 2026\u201327 academic year features Governor Tim Walz and major financial aid announcement for Carleton"},"content":{"rendered":"\n<p>After concluding the first day of classes, the Carleton community gathered to celebrate the start of the new academic year and recognize students on the Dean\u2019s List with Opening Convocation on September 14, 2026. Skinner Memorial Chapel was packed with students, faculty, and staff as the traditional Bubble Brigade oversaw the event from the Chapel balcony.<\/p>\n\n\n\n<p>This year\u2019s guest speaker was Minnesota Governor Tim Walz, who continues a 50-year-long tradition of the state\u2019s highest-ranking elected official speaking at Carleton at some point during their term.<\/p>\n\n\n\n<p>Walz is Minnesota\u2019s 41st Governor, first elected in 2018 and winning re-election in 2022. Accomplishments from his time in office include providing universal free school meals for K-12 students, protecting reproductive freedom, strengthening voting rights, laying the groundwork for Minnesota to achieve 100% clean electricity by 2040, cutting taxes for the middle class, and expanding paid leave for Minnesota workers.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_61-scaled.jpg?resize=1024,683&amp;crop=0,0,99,100\" alt=\"Governor Tim Walz speaks at Opening Convo.\" class=\"wp-image-44827\" style=\"aspect-ratio:1.4992704391425347;width:550px\"\/><\/figure>\n<\/div>\n\n\n<p>Echoing a sentiment that many have expressed over the decades, Walz began his convocation address by praising the distinction of Carleton\u2019s academics and the beauty of its campus, but ultimately emphasizing that the people of Carleton are what make it such a \u201cjewel\u201d of Minnesota.<\/p>\n\n\n\n<p>The people of Minnesota, including those at Carleton and in Northfield, were a primary focus of Walz\u2019s talk. In recounting the response to Operation Metro Surge earlier this year, Walz highlighted the \u201chumanity-first\u201d nature of Minnesota residents and how much he admired the commitment to \u201cbeing a good neighbor.\u201d<\/p>\n\n\n\n<p>\u201cMany of you [who] know Northfield, Minnesota, you already know this,\u201d he said, \u201cbut to first-year students \u2014 there <em>is<\/em> something different about Minnesota\u2026 [For this state], humanity comes first, your neighbor comes first, doing the right thing comes first, compassion and decency come first.\u201d<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_73-scaled.jpg?resize=1024,683&amp;crop=0,0,99,100\" alt=\"A group of students take a selfie with Governor Tim Walz.\" class=\"wp-image-44825\" style=\"aspect-ratio:1.4992704391425347;width:550px\"\/><\/figure>\n<\/div>\n\n\n<p>Walz also admitted to the audience that while he has deeply appreciated his work in politics, he is the most proud of being a teacher, and often feels that the classroom is where he actually had the most impact on people.<\/p>\n\n\n\n<p>\u201cI\u2019m telling you right now,\u201d he said. \u201cBe the teacher, be a nurse, be a small business owner, be on the faculty, be the poet, be the musician, be the community organizer. That\u2019s where change happens.\u201d<\/p>\n\n\n\n<p>Encouragement for current Carls was how Walz wrapped up his address, as he noted the challenges society faces right now and how a Carleton education gives current students the ability to face them.<\/p>\n\n\n\n<p>\u201cThis country and this world are going to need this generation,\u201d Walz said. \u201cWith the education you get at Carleton, with the friendships and connections you make, with the skills that you have, you\u2019re going to be the ones who figure this out\u2026 The people who are here, at an institution like Carleton, [are] our best hope for solving some of the most difficult problems.\u201d<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_62-scaled.jpg?resize=1024,683&amp;crop=0,0,99,100\" alt=\"Governor Tim Walz receives a standing ovation at Opening Convo in Skinner Chapel.\" class=\"wp-image-44826\" style=\"aspect-ratio:1.4992704391425347;width:550px\"\/><\/figure>\n<\/div>\n\n\n<p>Carleton President Alison Byerly followed Walz with her remarks, thanking him for his leadership, his emphasis on civic education, and his statements that celebrate Northfield, Minnesota as not the middle of nowhere, but rather the \u201ccenter of everything.\u201d<\/p>\n\n\n\n<p>Byerly\u2019s address acknowledged that Carleton is celebrating a historic milestone this fall: the establishment of Cowling Arboretum 100 years ago, in 1926.<\/p>\n\n\n\n<p>\u201cCarleton is fortunate to own and steward such an extraordinary resource for both recreation and research,\u201d Byerly said. \u201cThe Arb provides our community with generous space to hike, run, ski, snowshoe, or bird-watch. It also serves as a living laboratory that reflects the unique biological, geographic, and cultural heritage of this place. As an outdoor classroom for both formal courses and independent research, its impact is felt across the curriculum.\u201d<\/p>\n\n\n\n<p>The Arb \u201cencapsulates the goals and mission of Carleton as a liberal arts college,\u201d Byerly explained, as it is a \u201cplace set aside for a special purpose, yet also deeply embedded in the world around it. It is a place where doing and learning are inseparable from one another. And it is a place where seeds that are planted develop into rich landscapes over the course of many years. A liberal arts education, too, is about planting seeds for the future.\u201d<\/p>\n\n\n\n<p>Byerly continued to detail the philosophy behind Carleton\u2019s liberal arts education and discussed challenges currently faced by higher education, including concern about student loan debt. This led to her announcement that beginning in the 2027\u201328 academic year, Carleton will no longer require loans in any student\u2019s financial aid package.<\/p>\n\n\n\n<p>\u201cWe want any student for whom Carleton is the right choice to have the ability to choose Carleton,\u201d Byerly said. \u201cAnd we want every Carleton student to have the freedom to pursue whatever pathway they choose in the future, without feeling burdened by student debt.\u201d<\/p>\n\n\n\n<p><a href=\"https:\/\/www.carleton.edu\/news\/stories\/carleton-adopts-no-loan-financial-aid-policy\/\">Read the full announcement of Carleton\u2019s no-loan financial aid policy on Carleton News.<\/a><\/p>\n\n\n\n<p>Byerly\u2019s full remarks will be posted on the <a href=\"https:\/\/www.carleton.edu\/president\/communications\/presidents-remarks\/\">President\u2019s Office website<\/a>, and a recording of Opening Convocation will be archived on <a href=\"https:\/\/www.carleton.edu\/convocations\/archives\/\">the Carleton Convocations website<\/a>.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Minnesota Governor Tim Walz welcomed students, faculty, and staff to campus as the Opening Convo speaker. President Alison Byerly followed his address with her own remarks and the announcement that Carleton is implementing a no-loan financial aid policy starting next fall.<\/p>\n","protected":false},"author":9627,"featured_media":44828,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[7128,92,97],"tags":[],"class_list":["post-44824","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-college-news","category-events","category-traditions"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44824","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44824"}],"version-history":[{"count":3,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44824\/revisions"}],"predecessor-version":[{"id":44831,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44824\/revisions\/44831"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media\/44828"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44824"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44824"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44824"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:featuredmedia":[{"id":44828,"date":"2026-09-15T11:03:43","slug":"opening_convo_51","type":"attachment","link":"https:\/\/www.carleton.edu\/news\/opening_convo_51\/","title":{"rendered":"Opening_Convo_51"},"author":9627,"featured_media":0,"acf":[],"caption":{"rendered":""},"alt_text":"Governor Tim Walz and President Alison Byerly smile widely onstage at Opening Convo, with faculty standing behind them in the raised pews.","media_type":"image","mime_type":"image\/jpeg","media_details":{"width":2560,"height":1707,"file":"2026\/09\/Opening_Convo_51-scaled.jpg","filesize":624508,"sizes":{"thumbnail":{"file":"Opening_Convo_51-scaled.jpg?resize=150,150&crop=17,0,66,100","width":150,"height":150,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=150,150&crop=17,0,66,100"},"medium":{"file":"Opening_Convo_51-scaled.jpg?resize=300,200&crop=0,0,100,99","width":300,"height":200,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=300,200&crop=0,0,100,99"},"medium_large":{"file":"Opening_Convo_51-scaled.jpg?resize=768,512&crop=0,0,100,99","width":768,"height":512,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=768,512&crop=0,0,100,99"},"large":{"file":"Opening_Convo_51-scaled.jpg?resize=1024,683&crop=0,0,99,100","width":1024,"height":683,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=1024,683&crop=0,0,99,100"},"1536x1536":{"file":"Opening_Convo_51-scaled.jpg?resize=1536,1024&crop=0,0,100,99","width":1536,"height":1024,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=1536,1024&crop=0,0,100,99"},"2048x2048":{"file":"Opening_Convo_51-scaled.jpg?resize=2048,1366&crop=0,0,99,100","width":2048,"height":1366,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=2048,1366&crop=0,0,99,100"},"rectangle_proportional_w400":{"file":"Opening_Convo_51-scaled.jpg?resize=400,267&crop=0,0,99,100","width":400,"height":267,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=400,267&crop=0,0,99,100"},"square_800":{"file":"Opening_Convo_51-scaled.jpg?resize=800,800&crop=17,0,66,100","width":800,"height":800,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=800,800&crop=17,0,66,100"},"rectangle_3x2_800":{"file":"Opening_Convo_51-scaled.jpg?resize=800,533&crop=0,0,100,99","width":800,"height":533,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=800,533&crop=0,0,100,99"},"rectangle_golden_700":{"file":"Opening_Convo_51-scaled.jpg?resize=700,394&crop=0,8,100,84","width":700,"height":394,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=700,394&crop=0,8,100,84"},"rectangle_1440x420":{"file":"Opening_Convo_51-scaled.jpg?resize=1440,420&crop=0,28,100,43","width":1440,"height":420,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Opening_Convo_51-scaled.jpg?resize=1440,420&crop=0,28,100,43"},"rectangle_3x1_1440":{"file":"O