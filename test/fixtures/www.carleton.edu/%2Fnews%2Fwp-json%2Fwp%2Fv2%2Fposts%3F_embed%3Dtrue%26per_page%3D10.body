[{"id":44885,"date":"2026-09-20T14:56:57","date_gmt":"2026-09-20T19:56:57","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44885"},"modified":"2026-09-20T14:56:58","modified_gmt":"2026-09-20T19:56:58","slug":"mary-precious-feutsop-ngouane-27-selected-for-american-physical-society-student-ambassador-cohort","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/mary-precious-feutsop-ngouane-27-selected-for-american-physical-society-student-ambassador-cohort\/","title":{"rendered":"Mary Precious Feutsop Ngouane \u201927 selected for American Physical Society student ambassador cohort"},"content":{"rendered":"\n<p>Mary Precious Feutsop Ngouane \u201927 has been selected by the American Physical Society (APS) for its 2026\u201327 student ambassador cohort. &#8220;These outstanding undergraduate and graduate students from around the world will lead outreach efforts on their campuses and share APS resources with their communities.&#8221;<\/p>\n\n\n\n<p><a href=\"https:\/\/www.aps.org\/membership\/student-ambassadors\/student-ambassador-cohort\">Read the full list of this year&#8217;s cohort.<\/a><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Feutsop Ngouane is double-majoring in computer science and physics at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[7089,7196],"tags":[],"class_list":["post-44885","post","type-post","status-publish","format-standard","hentry","category-elsewhere","category-grants-awards"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44885","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44885"}],"version-history":[{"count":2,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44885\/revisions"}],"predecessor-version":[{"id":44887,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44885\/revisions\/44887"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44885"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44885"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44885"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7196,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/grants-awards\/","name":"Grants &amp; Awards","slug":"grants-awards","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7196","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7196"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7196"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44875,"date":"2026-09-20T14:45:19","date_gmt":"2026-09-20T19:45:19","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44875"},"modified":"2026-09-20T14:45:21","modified_gmt":"2026-09-20T19:45:21","slug":"four-carleton-alumni-selected-for-japan-exchange-and-teaching-program","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/four-carleton-alumni-selected-for-japan-exchange-and-teaching-program\/","title":{"rendered":"Four Carleton alumni selected for Japan Exchange and Teaching Program"},"content":{"rendered":"\n<p>Four Carleton alumni are traveling to Japan this fall to take part in the <a href=\"https:\/\/jetprogramme.org\/en\/\">Japan Exchange and Teaching (JET) program<\/a>: Alejo Enriquez-Lynd \u201926, Zaria Kelly \u201925, Alek Pochan \u201926, and Lucas Schattenmann \u201926.<\/p>\n\n\n\n<p>Established in 1987, JET remains the only teaching exchange program managed by the Japanese government, drawing instructors from over 80 countries worldwide. The program has two pathway options: Assistant Language Teacher (ALT) or Coordinator for International Relations (CIR).<\/p>\n\n\n\n<p>The majority of JET participants \u2014 including Enriquez-Lynd, Kelly, and Pochan \u2014 have no Japanese fluency requirement and serve as ALTs, teaching English in local schools. CIRs, in contrast, require a high degree of Japanese fluency and are contracted by local government offices to perform a wide range of duties under the umbrella of international relations. Schattenmann, Carleton\u2019s only CIR for this year, will work with translation and interpretation, outreach to foreign residents, education, and exchange activities.<\/p>\n\n\n\n<p>All four of this year\u2019s JET Carls are excited to improve their Japanese language skills and immerse themselves in their respective living locations.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-full is-resized\"><img decoding=\"async\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/alejo-cropped_square.png\" alt=\"Cropped photo of Alejo Enriquez-Lynd.\" class=\"wp-image-44878\" style=\"width:350px\"\/><figcaption class=\"wp-element-caption\">Alejo Enriquez-Lynd \u201926<\/figcaption><\/figure>\n<\/div>\n\n\n<p>\u201cI&#8217;m really excited to be in [Osaka], a big city with lots of things to do and great access to the rest of Japan,\u201d Enriquez-Lynd said. \u201cOsaka is also basically next door to Kyoto, so I&#8217;m excited to be able to visit the friends I made over my study abroad there pretty easily\u2026 Also, as much as I love Japan and I&#8217;m excited to actually live there, I&#8217;m really passionate about sharing my own American-Mexican culture with the world, and JET is a really great way to do that.\u201d<\/p>\n\n\n\n<p>\u201cI am looking forward to showing my students different parts of American culture that they had no idea about, and hopefully inspire them to travel here one day!\u201d Kelly added. \u201cMy personal goal for this program is also to immerse myself as much as possible into the culture and make an impact on the community I will be living in. It is very important to me that I not only be an observer or consumer of my community, but also a contributor.\u201d<\/p>\n\n\n\n<p>\u201cI want to be a memorable role model for kids and help them feel a sense of achievement,\u201d Pochan said. \u201cI also want to feel truly comfortable living in rural Japan! [I\u2019m excited to] bike around my town, go to bars and talk to older community members, and go to bath houses.\u201d<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"1024\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/lucas-headshot.jpg?resize=1024,1024&amp;crop=0,0,100,99\" alt=\"Headshot of Lucas Schattenmann.\" class=\"wp-image-44880\" style=\"width:350px\"\/><figcaption class=\"wp-element-caption\">Lucas Schattenmann \u201926<\/figcaption><\/figure>\n<\/div>\n\n\n<p>\u201cI think working alongside Japanese colleagues and living my daily life in the language for a sustained period of time will really accelerate my learning and keep me motivated,\u201d Schattenmann said. \u201cI&#8217;m excited about many of the responsibilities I&#8217;ll be taking on as a CIR, [like] cultural exchange and translating\u2026 I&#8217;m already thinking of ideas for events or projects I might be able to help with during my time there. I&#8217;m motivated to make my mark and bring positive change to the town I&#8217;ll be working in.\u201d<\/p>\n\n\n\n<p>Enriquez-Lynd, Kelly, Pochan, and Schattenmann all have a unique perspective and experiences from Carleton that inspired them to apply for this opportunity.<\/p>\n\n\n\n<p>Enriquez-Lynd, a double major in Japanese language &amp; literature and mathematics, is interested in exploring the intersection of language learning, community building, and pedagogy. He realized his interest in teaching in part through Professor Deanna Haunsperger&#8217;s Methods of Teaching Mathematics course at Carleton.<\/p>\n\n\n\n<p>\u201cObviously Deanna is a great professor who&#8217;s incredibly passionate about teaching, and she got me excited about actually doing it, but the course itself was surprisingly relevant to teaching English abroad,\u201d Enriquez-Lynd said. \u201cSimilar to English in Japan, math is a subject a lot of students struggle with, and can often be taught in a way that overemphasizes rote memorization without much opportunity for real creativity. Her class inspired me to try to be the teacher I wished I had!\u201d<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"1024\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Zaria_for-JET_square.png?resize=1024,1024\" alt=\"Headshot of Zaria Kelly.\" class=\"wp-image-44881\" style=\"width:350px\"\/><figcaption class=\"wp-element-caption\">Zaria Kelly \u201925<\/figcaption><\/figure>\n<\/div>\n\n\n<p>Kelly, who majored in classical studies, learned how to be open to new experiences and not let fear of failure hold her back at Carleton \u2014 she will bring that energy abroad with her.<\/p>\n\n\n\n<p>\u201cSome of my best memories at Carleton were ones where I did something outside of my comfort zone and enjoyed it,\u201d she said. \u201cCarleton also taught me that I am capable of doing difficult things and equipped me with the critical thinking skills, adaptability, and resourcefulness to get through them. Studying abroad in Japan in my sophomore year was my first time overseas, and was the experience that made a major impact on my worldview and shaped the person I am today. I got to see, do, and learn about things that I had never even known had existed. It was truly life changing.\u201d<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-full is-resized\"><img decoding=\"async\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/alek.jpg\" alt=\"Headshot of Alek Pochan.\" class=\"wp-image-44879\" style=\"width:350px\"\/><figcaption class=\"wp-element-caption\">Alek Pochan \u201926<\/figcaption><\/figure>\n<\/div>\n\n\n<p>As a religion major with leadership experience ranging from Ultimate Frisbee team captain to leading a local church youth group, Pochan was focused on why the teaching aspect of JET was right for him and a good fit with his experiences, rather than just his excitement to live in a foreign country \u2014 even though both were important in his deliberation around applying.<\/p>\n\n\n\n<p>\u201cIt will be great to get some classroom experience,\u201d he added, \u201cbecause I think I may want to keep teaching high school or middle school in the future.\u201d<\/p>\n\n\n\n<p>Another double major, this time in computer science alongside Japanese language &amp; literature, Schattenmann came to Carleton with \u201cclose to zero\u201d Japanese language ability, citing Carleton\u2019s \u201cincredible Japanese education\u201d for his current language skills and the ability to continue learning and adapting, which he knows will be crucial during his time living abroad.<\/p>\n\n\n\n<p>\u201cI think this is a great opportunity for career advancement and Japanese language acquisition, which I think will feel very fulfilling and serve me well into the future,\u201d Schattenmann said. \u201cI&#8217;m not quite sure what I&#8217;ll do after JET yet, but I figure this is something which will take shape as I continue with the program.\u201d<\/p>\n\n\n\n<p>JET participants can remain in Japan for up to five years, allowing for deep cultural immersion and extension into multiple career paths.&nbsp;<\/p>\n\n\n\n<p>\u201cI just want to do the best job I possibly can!\u201d Enriquez-Lynd said. \u201cIf I can inspire one student to pursue learning English more seriously or travel the world, I&#8217;d be immensely proud.\u201d<\/p>\n\n\n\n<p>For any current or future Carls interested in applying for the JET program, each of this year\u2019s participating alumni recommended talking to the Carleton Japanese department \u2014 they thanked every professor personally! \u2014 and getting in touch with the <a href=\"https:\/\/www.carleton.edu\/fellowships\/\">Office of Student Fellowships<\/a>, which they all mentioned as extraordinarily helpful in the application process.<\/p>\n\n\n\n<p>But the most important piece of advice they had? Just go for it!<\/p>\n\n\n\n<p>\u201cUltimately,\u201d Schattenmann said, \u201cas long as you keep up consistent enthusiasm for sharing your culture with others and learning Japanese, you will be just fine.\u201d<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Alejo Enriquez-Lynd \u201926, Zaria Kelly \u201925, Alek Pochan \u201926, and Lucas Schattenmann \u201926 were all selected.<\/p>\n","protected":false},"author":9627,"featured_media":44882,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[75,7196],"tags":[],"class_list":["post-44875","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-alumni","category-grants-awards"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44875","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44875"}],"version-history":[{"count":4,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44875\/revisions"}],"predecessor-version":[{"id":44884,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44875\/revisions\/44884"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media\/44882"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44875"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44875"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44875"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:featuredmedia":[{"id":44882,"date":"2026-09-20T14:41:48","slug":"japanese-garden_largeimage_m135005","type":"attachment","link":"https:\/\/www.carleton.edu\/news\/japanese-garden_largeimage_m135005\/","title":{"rende