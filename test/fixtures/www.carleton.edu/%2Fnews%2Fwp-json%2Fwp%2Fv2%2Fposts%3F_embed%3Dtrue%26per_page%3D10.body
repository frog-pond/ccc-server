mage_m133753-scaled.jpg","_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media\/44872","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/attachment"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}]}}],"wp:term":[[{"id":80,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/academics\/","name":"Academics","slug":"academics","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/80","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=80"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=80"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7196,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/grants-awards\/","name":"Grants &amp; Awards","slug":"grants-awards","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7196","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7196"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7196"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7098,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/kudos\/","name":"Kudos","slug":"kudos","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7098","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7098"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7098"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44848,"date":"2026-09-15T17:31:09","date_gmt":"2026-09-15T22:31:09","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44848"},"modified":"2026-09-15T17:31:11","modified_gmt":"2026-09-15T22:31:11","slug":"kiley-kost-and-seth-peabody-co-edit-special-issue-of-german-studies-journal","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/kiley-kost-and-seth-peabody-co-edit-special-issue-of-german-studies-journal\/","title":{"rendered":"Kiley Kost and Seth Peabody co-edit special issue of German studies journal"},"content":{"rendered":"\n<p>Kiley Kost, lecturer in German, and Seth Peabody, assistant professor of German, co-edited a special issue of the journal <em>German Politics and Society<\/em> on \u201c<a href=\"https:\/\/www.berghahnjournals.com\/view\/journals\/gps\/44\/2-3\/gps.44.issue-2-3.xml\">Cultures of Climate Action in Germany<\/a>,\u201d which is available open access. Kost and Peabody also co-authored <a href=\"https:\/\/www.berghahnjournals.com\/view\/journals\/gps\/44\/2-3\/gps4402-301.xml\">the issue&#8217;s introduction<\/a> with their co-editors.<\/p>\n\n\n\n<p>In addition, Peabody published an article in the special issue, \u201c<a href=\"https:\/\/www.berghahnjournals.com\/view\/journals\/gps\/44\/2-3\/gps4402-305.xml\">Bicycle Greenwishing: Images of Sustainability and Infrastructures of Solidarity in Munich and Berlin<\/a>,\u201d co-authored with Jennifer Hosek of Queen\u2019s University in Canada.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Kost is lecturer in German and Peabody is assistant professor of German at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[7089],"tags":[],"class_list":["post-44848","post","type-post","status-publish","format-standard","hentry","category-elsewhere"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44848","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44848"}],"version-history":[{"count":2,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44848\/revisions"}],"predecessor-version":[{"id":44850,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44848\/revisions\/44850"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44848"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44848"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44848"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44845,"date":"2026-09-15T17:26:03","date_gmt":"2026-09-15T22:26:03","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44845"},"modified":"2026-09-15T17:26:05","modified_gmt":"2026-09-15T22:26:05","slug":"deborah-gross-ellen-iverson-kristin-oconnell-04-publish-paper-with-carleton-alumni","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/deborah-gross-ellen-iverson-kristin-oconnell-04-publish-paper-with-carleton-alumni\/","title":{"rendered":"Deborah Gross, Ellen Iverson, Kristin O&#8217;Connell \u201904 publish paper with Carleton alumni"},"content":{"rendered":"\n<p>Deborah Gross, Charles &#8220;Jim&#8221; and Marjorie Kade Professor of the Sciences; Ellen Iverson, director of the Science Education Resource Center (SERC); and Kristin O&#8217;Connell \u201904, evaluation\/education associate in SERC, published a paper with multiple Carleton alumni: Jonathan Nguyen \u201925, Jelimo Kaitany \u201924, Mo Armstrong \u201923, Yelena Hallman \u201922, Milon Hutchinson \u201921, Vermilion Villarreal \u201919, David Higgs \u201918, Ernesto Polania-Gonzalez \u201917, and Chloe Bergstrand \u201916.<\/p>\n\n\n\n<p>The paper, &#8220;Greater than the sum: programs to support the whole student in STEM during and after college,&#8221; is in an issue of <em>Frontiers in Education<\/em> celebrating the NSF&#8217;s Louis Stokes Alliances for Minority Participation.<\/p>\n\n\n\n<p><a href=\"https:\/\/www.frontiersin.org\/journals\/education\/articles\/10.3389\/feduc.2026.1816063\/full\">Read the full paper.<\/a><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Gross is Charles &#8220;Jim&#8221; and Marjorie Kade Professor of the Sciences. Iverson and O&#8217;Connell are both with the Science Education Resource Center at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[75,7089],"tags":[],"class_list":["post-44845","post","type-post","status-publish","format-standard","hentry","category-alumni","category-elsewhere"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44845","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}],"replies":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/comments?post=44845"}],"version-history":[{"count":2,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44845\/revisions"}],"predecessor-version":[{"id":44847,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44845\/revisions\/44847"}],"wp:attachment":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media?parent=44845"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories?post=44845"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/tags?post=44845"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":9627,"name":"Erica Helgerud","url":"","description":"","link":"https:\/\/www.carleton.edu\/news\/stories\/author\/ehelgerud\/","slug":"ehelgerud","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/70d6df5d8854273e48f61582efca6dba0141350fdc063b8ea4f592c64f88bc3d?s=96&d=mm&r=g"},"user_switching_url":null,"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":75,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/alumni\/","name":"Alumni","slug":"alumni","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/75","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=75"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=75"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7089,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/elsewhere\/","name":"Elsewhere","slug":"elsewhere","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7089","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7089"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7089"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44833,"date":"2026-09-15T16:27:10","date_gmt":"2026-09-15T21:27:10","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44833"},"modified":"2026-09-17T16:25:36","modified_gmt":"2026-09-17T21:25:36","slug":"carleton-no-loan-financial-aid-policy-covered-by-local-and-national-news-outlets","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/carleton-no-loan-financial-aid-policy-covered-by-local-and-national-news-outlets\/","title":{"rendered":"Carleton no-loan financial aid policy covered by local and national news outlets"},"content":{"rendered":"\n<p>Carleton <a href=\"https:\/\/www.carleton.edu\/news\/stories\/carleton-adopts-no-loan-financial-aid-policy\/\">announced its adoption of a no-loan financial aid policy<\/a> on September 14, 2026, which led to news coverage from various local and national news outlets. This coverage included:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>&#8220;<a href=\"https:\/\/www.insidehighered.com\/news\/quick-takes\/2026\/09\/15\/carleton-college-adopts-no-loan-financial-aid-policy\" target=\"_blank\" rel=\"noreferrer noopener\">Carleton College Adopts No-Loan Financial Aid Policy<\/a>&#8221; from <em>Inside<\/em> <em>Higher Ed<\/em>\n<ul class=\"wp-block-list\">\n<li>This piece was also included in the \u201cQuick Takes\u201d section of the September 15 edition of the outlet&#8217;s email newsletter.<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.startribune.com\/carleton-college-drops-loans-from-financial-aid-making-college-free-for-many-families\/601888082\">Carleton College drops loans from financial aid, reducing long-term cost for many students<\/a>&#8221; from <em>The Minnesota Star Tribune<\/em><\/li>\n\n\n\n<li>President Alison Byerly was interviewed live on FOX 9 Minneapolis-St. Paul\n<ul class=\"wp-block-list\">\n<li>The segment is <a href=\"https:\/\/youtu.be\/9F523seFBxI?si=z_pdoFCcQbg2DDN4\">available to watch on the FOX 9 YouTube channel<\/a>.<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.cbsnews.com\/minnesota\/news\/carleton-college-eliminates-student-loans-northfield\/\">Carleton College students will be able to graduate debt-free after school eliminates loans<\/a>&#8221; from CBS News Minnesota\n<ul class=\"wp-block-list\">\n<li>This story was also <a href=\"https:\/\/www.yahoo.com\/news\/videos\/minnesota-college-launches-program-help-230900087.html\">distributed by Yahoo News<\/a>.<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.mprnews.org\/episode\/2026\/09\/15\/fbi-works-with-utilities-to-strengthen-cyber-security-carleton-college-eliminates-loans\">Carleton College eliminates loans<\/a>&#8221; from a Minnesota Today segment aired by MPR News<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/kymnradio.net\/2026\/09\/15\/carleton-to-eliminate-loans-from-financial-aid-packages-beginning-in-2027\/\">Carleton to Eliminate Loans from Financial Aid Packages Beginning in 2027<\/a>&#8221; from KYMN<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.southernminn.com\/northfield_news\/news\/carleton-to-eliminate-loans-for-new-continuing-students\/article_7593fc68-7bab-438e-9506-698269163567.html\">Carleton to eliminate loans for new, continuing students<\/a>&#8221; from <em>Northfield News<\/em><\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.kttc.com\/2026\/09\/14\/carleton-college-removes-loans-financial-aid-packages\/\">Carleton College removes loans from financial aid packages<\/a>&#8221; from KTTC and &#8220;<a href=\"https:\/\/www.myklgr.com\/local-news\/carleton-college-to-eliminate-loans\/\">Carleton College To Eliminate Loans<\/a>&#8221; from KLGR<\/li>\n\n\n\n<li>The announcement was included in the <em>Chronicle of Higher Education<\/em>&#8216;s <a href=\"https:\/\/www.chronicle.com\/newsletter\/daily-briefing\/2026-09-16\">Daily Briefing newsletter for September 16<\/a><\/li>\n\n\n\n<li>The announcement was part of MinnPost&#8217;s <a href=\"https:\/\/www.minnpost.com\/glean\/2026\/09\/are-you-still-being-followed-by-the-teenage-fbi-news-roundup\/\">daily news roundup for September 16<\/a><\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/bringmethenews.com\/minnesota-news\/carleton-college-announces-new-no-loan-financial-aid-policy\">Carleton College announces new \u2018no loan\u2019 financial aid policy<\/a>&#8221; from Bring Me the News<\/li>\n\n\n\n<li>&#8220;<a href=\"https:\/\/www.businessinsider.com\/colleges-getting-rid-of-student-loan-debt-carleton-repayment-relief-2026-9\">The number of colleges getting rid of student debt is growing<\/a>&#8221; from <em>Business Insider<\/em><\/li>\n<\/ul>\n\n\n\n<p><em>This story will be updated as more coverage is published.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Coverage included Inside Higher Ed, the Star Tribune, and CBS, among others.<\/p>\n","protected":false},"author":9627,"