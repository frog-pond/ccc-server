le_proportional_h480":{"file":"Japanese-Garden_LargeImage_m135005-scaled.jpg?resize=720,480&crop=0,1,100,99","width":720,"height":480,"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Japanese-Garden_LargeImage_m135005-scaled.jpg?resize=720,480&crop=0,1,100,99"},"full":{"file":"Japanese-Garden_LargeImage_m135005-scaled.jpg","width":2560,"height":1707,"mime_type":"image\/jpeg","source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Japanese-Garden_LargeImage_m135005-scaled.jpg"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[]},"original_image":"Japanese-Garden_LargeImage_m135005.jpg"},"source_url":"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2026\/09\/Japanese-Garden_LargeImage_m135005-scaled.jpg","_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media\/44882","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/media"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/attachment"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/users\/9627"}]}}],"wp:term":[[{"id":75,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/alumni\/","name":"Alumni","slug":"alumni","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/75","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=75"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=75"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":7196,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/grants-awards\/","name":"Grants &amp; Awards","slug":"grants-awards","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7196","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7196"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7196"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44869,"date":"2026-09-18T10:06:02","date_gmt":"2026-09-18T15:06:02","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44869"},"modified":"2026-09-18T10:06:03","modified_gmt":"2026-09-18T15:06:03","slug":"stephen-mohring-awarded-periclean-faculty-leader-course-grant","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/stephen-mohring-awarded-periclean-faculty-leader-course-grant\/","title":{"rendered":"Stephen Mohring awarded Periclean Faculty Leader Course Grant"},"content":{"rendered":"<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"791\" height=\"1024\"  src=\"https:\/\/cdn.carleton.edu\/uploads\/sites\/392\/2020\/06\/1493542_orig-scaled.jpg?resize=791,1024\" alt=\"Headshot of Stephen Mohring.\" class=\"wp-image-10215\" style=\"width:350px\"\/><figcaption class=\"wp-element-caption\">Stephen Mohring<\/figcaption><\/figure>\n<\/div>\n\n\n<p>Stephen Mohring, professor of art, has <a href=\"https:\/\/projectpericles.org\/news\/project-pericles-awards-16-grants-to-deepen-civic-learning-on-campus\/\">received an inaugural Periclean Faculty Leader (PFL) Course Grant<\/a>. Funding from this Project Pericles grant will support the development of a new ACE course at Carleton, Habitats and Humanity: Considering Built Spaces, which will be taught for the first time in Spring 2027.<\/p>\n\n\n\n<p>Mohring&#8217;s course will consider the built environment \u2014 often viewed as a static object \u2014 as a dynamic intersection of personal desire, artistic expression, social justice, and structural engineering. Students will bridge the gap between architectural idealism and pragmatic reality, examining how built spaces function as social infrastructure and how theoretical assumptions of modern design and the politics of housing dictate who gets to feel \u201cat home.\u201d A partnership with the local Habitat for Humanity chapter will enable students to engage directly with the Rice County housing landscape, making the economic and sociopolitical realities of habitation tangible, moving students from abstract discussions of spatial planning into applied community action.<\/p>\n\n\n\n<p>Project Pericles&#8217;&nbsp;<a href=\"https:\/\/www.projectpericles.org\/periclean-faculty-leadership-pfl.html\" target=\"_blank\" rel=\"noreferrer noopener\">PFL program<\/a>&nbsp;supports faculty who are dedicated to incorporating civic and community engagement into the curriculum while empowering students to use their academic knowledge to tackle real-world problems.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Mohring is professor of art at Carleton.<\/p>\n","protected":false},"author":9627,"featured_media":44872,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[80,7196,7098],"tags":[],"class_list":["post-44869","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-academics","category-grants-awards","category-kudos"],"acf":[],"_li