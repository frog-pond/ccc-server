	<script>
	jQuery(document).ready(function($) {
		var all_checkbox = $('#bamco-newsletter-subscription-cafes-all');
		var cafe_checkboxes = $('.bamco-newsletter-cafe-checkbox');

		if ( ! all_checkbox.length ) {
			return;
		}
		// If the "all cafes" checkbox is checked, uncheck all the cafe checkboxes
		all_checkbox.on( 'change', function() {
			if ( $(this).is(':checked') ) {
				cafe_checkboxes.prop( 'checked', false );
			}
		});
		// If any of the cafe checkboxes are checked, uncheck the "all cafes" checkbox
		cafe_checkboxes.on( 'change', function() {
			if ( $(this).is(':checked') ) {
				all_checkbox.prop( 'checked', false );
			}
		});
	});
</script>

