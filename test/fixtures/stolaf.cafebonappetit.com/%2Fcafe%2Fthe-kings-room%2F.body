											id="bamco-newsletter-subscription-cafes-244"
											value="244"
																					/>
										<label for="bamco-newsletter-subscription-cafes-244">The Cage</label>
								</span>
																							<span class="form-control-checkbox form-control-custom-style">
										<input
											class="bamco-newsletter-cafe-checkbox"
											type="checkbox"
											name="subscription[cafes][]"
											id="bamco-newsletter-subscription-cafes-245"
											value="245"
