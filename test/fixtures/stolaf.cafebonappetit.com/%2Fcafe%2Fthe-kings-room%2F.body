             data-livetext>
                            
<div class="c-card g-col g-col-style--white">

			<header class="c-card__header">
			
<div >
			<figure   class="c-card__img">
	
	
					<img class=""  alt="A composed salad of a variety of vegetables, greens, rice, and nuts." src="https://images.media.cafebonappetit.com/uploads/sites/2/2019/08/iStock-1047798886_eat-right-for-you-wellness_1200px-640x480.jpg" sizes="(min-width: 1260px) 1260px, 100vw" srcset="https://images.media.cafebonappetit.com/uploads/sites/2/2019/08/iStock-1047798886_eat-right-for-you-wellness_1200px-640x480.jpg 640w 480h, 
