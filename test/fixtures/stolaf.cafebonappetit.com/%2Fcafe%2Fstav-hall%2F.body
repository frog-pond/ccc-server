							<p class='current-status'>Weekly Schedule</p><ul class='list-unstyled'><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Breakfast&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Mon-Fri, 7:15 am - 9:45 am</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Breakfast&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Sat, 8:00 am - 9:30 am</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Breakfast&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Sun, 9:00 am - 10:30 am</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Brunch&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Sat, 11:00 am - 1:30 pm</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Brunch&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Sun, 10:30 am - 1:30 pm</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Lunch&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Mon-Fri, 10:30 am - 2:00 pm</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Dinner&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Mon-Thu, 4:30 pm - 8:00 pm</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Dinner&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Fri-Sun, 4:30 pm - 7:30 pm</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Continuous Dining&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Mon-Fri, 9:45 am - 10:30 am</span></li><li class='day-part dotted-leader-container'><span class='dotted-leader-content pull-left'>Continuous Dining&nbsp;&nbsp;</span><span class='dotted-leader-content pull-right'>&nbsp;&nbsp;&nbsp;Mon-Fri, 2:00 pm - 4:30 pm</span></li></ul>
