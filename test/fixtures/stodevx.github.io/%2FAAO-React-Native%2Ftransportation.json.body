{"data":[{"name":"Hiawathaland Transit","category":"Local","url":"https://wp.stolaf.edu/transportation/express-bus/","synopsis":"Free route bus that stops at both colleges, Division Street, Target/Cub, and El Tequila/Culvers.","description":""},{"name":"Ole Bikes","category":"Local","url":"https://wp.stolaf.edu/sga/bikes/","synopsis":"Great green alternative, available for check-out through Rølvaag Library.","description":""},{"name":"Campus-Go","category":"Local","url":"https://wp.stolaf.edu/transportation/oles-go/","synopsis":"On-demand daytime transportation for students to volunteer work, medical appointments, pharmacy trips, or work locally, not intended for shopping or other personal trips. Call 507-301-4818 to schedule a ride.","description":""},{"name":"Break Airport Shuttles","category":"Airport Shuttle","url":"https://northfield.betterez.com/cart/5787e3b01f39300a1a000085","synopsis":"Northfield Lines shuttle operates only immediately before and after break. You must buy tickets 48 hours in advance.","description":""},{"name":"First Choice Shuttle","category":"Airport Shuttle","url":"http://youarriveontime.com","synopsis":"Shuttle service to and from MSP airports, bus and train depots, local shuttle, medical appointments, casinos, and package delivery.","description":""},{"name":"Transportation Options","category":"","url":"https://wp.stolaf.edu/transportation/","synopsis":"View all available transportation options on the St. Olaf website.","description":""}]}
