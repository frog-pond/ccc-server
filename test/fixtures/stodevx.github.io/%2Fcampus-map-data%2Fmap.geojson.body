      "properties": {
        "accessibility": "unknown",
        "address": null,
        "categories": [
          "building",
          "athletics"
        ],
        "departments": [
          {
            "href": "https://wp.stolaf.edu/commencement/",
            "label": "commencement"
          }
        ],
        "description": "The Ade Christenson Complex on the east side of campus is home to Klein Field at Manitou, the Manitou Track, and Tom Porter Hall. The playing and running surfaces are first-class competition sites for the football and men's and women's track and field teams. Two classrooms, locker rooms, an athletic training room, offices for coaches and staff, and a weight room make Tom Porter Hall a convenient home to the football, track and field, and men's and women's hockey teams. The lobby overlooks the west end zone and track, and it has a clear view of the bleachers and press box. The venue is also the home of the college's commencement ceremonies.",
        "floors": [],
        "name": "Ade Christenson Complex",
        "nickname": "ACA",
        "offices": [],
        "abbreviation": "ACA",
        "type": "Athletics",
        "links": [
