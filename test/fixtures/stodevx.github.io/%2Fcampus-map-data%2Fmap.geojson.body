          "point-of-interest",
          "dining"
        ],
        "departments": [],
        "description": "Located on the second floor of Buntrock Commons, Stav Hall is the central dining room on campus. It offers students and guests all-you-can-eat dining for breakfast, lunch, and dinner. Stations throughout the cafeteria offer a wide variety of food, from chef-carved meats with home-style casseroles to creative vegan entrees to pan-Asian cuisine. Stav Hall also features two soups made in house daily, an extensive fruit and salad bar, and a selection of outstanding desserts.",
        "floors": [],
        "name": "Stav Hall",
        "nickname": "",
        "offices": [],
        "abbreviation": null,
        "type": null,
        "links": [
