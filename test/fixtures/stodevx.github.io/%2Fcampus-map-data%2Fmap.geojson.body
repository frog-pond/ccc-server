      "properties": {
        "accessibility": "unknown",
        "address": null,
        "categories": [
          "building",
          "administrative",
          "academic"
        ],
        "departments": [
          {
            "href": "https://wp.stolaf.edu/music",
            "label": "Music Department"
          }
        ],
        "description": "The Hall of Music, which opened in February 2012, provides extended space for the Music Department. Complementing Christiansen Hall of Music, the new Hall of Music (more commonly known as the \"Music Box\") hosts 36 practice rooms, including two concerto rooms with two grand pianos; four chamber music rehearsal spaces; a reed room for double reeds; a percussion suite; 12 faculty studios; and the Music Department office. The Hall of Music connects with Alumni Hall to the west and the Center for Art and Dance (home to the Art/Art History and Dance departments) to the east. Related Links Music Department",
        "floors": [],
        "name": "(Tweet) Hall of Music",
        "nickname": "HOM",
        "offices": [],
        "abbreviation": "HOM",
        "type": "Administrative & Academic",
        "links": [],
        "parent": null
      }
    },
