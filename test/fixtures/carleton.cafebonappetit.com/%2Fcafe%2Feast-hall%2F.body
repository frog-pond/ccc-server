<div class="c-card__desc" >
	
<div class="t-content wysiwyg__content" >
	<figure class="wp-image wp-image--no-caption aligncenter"><img fetchpriority="high" decoding="async" class="size-full wp-image-12414" src="https://images.media.cafebonappetit.com/uploads/sites/207/2018/05/FRV-Logo-225x300.jpg" alt="" width="225" height="300" /></figure>

