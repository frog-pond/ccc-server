ww.carleton.edu\/news\/stories\/category\/college-news\/","name":"College News","slug":"college-news","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/7128","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=7128"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=7128"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":13677,"link":"https:\/\/www.carleton.edu\/news\/stories\/category\/sustainability\/","name":"Sustainability","slug":"sustainability","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories\/13677","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts?categories=13677"},{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/faq?categories=13677"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":44888,"date":"2026-09-21T08:38:57","date_gmt":"2026-09-21T13:38:57","guid":{"rendered":"https:\/\/www.carleton.edu\/news\/?p=44888"},"modified":"2026-10-02T14:52:59","modified_gmt":"2026-10-02T19:52:59","slug":"geoffrey-jing-25-featured-in-new-york-times-story-on-ai-start-ups","status":"publish","type":"post","link":"https:\/\/www.carleton.edu\/news\/stories\/geoffrey-jing-25-featured-in-new-york-times-story-on-ai-start-ups\/","title":{"rendered":"Geoffrey Jing \u201925 featured in New York Times story on AI start-ups"},"content":{"rendered":"\n<blockquote class=\"wp-block-quote is-layout-flow wp-block-quote-is-layout-flow\">\n<p>Geoffrey Jing joined the consulting firm Bain &amp; Company after he graduated from Carleton College, taking the well-worn path funneling top students into high-paying jobs at leading corporate consulting firms.<\/p>\n\n\n\n<p>He figured that, like many before him, he would work at the firm for two years and then jump to something else.<\/p>\n\n\n\n<p>He figured wrong. Three months into the job, he quit and soon jumped to a start-up called Sieve, which builds data sets and environments for labs developing A.I. models.<\/p>\n\n\n\n<p>\u201cI wanted to spend more of my early career building more closely in A.I.,\u201d Mr. Jing, 23, said.<\/p>\n<\/blockquote>\n\n\n\n<p><a href=\"https:\/\/www.nytimes.com\/2026\/09\/21\/business\/consulting-firms-employees-ai-startups.html?smid=url-share\">Read more from The New York Times.<\/a><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Jing joined the consulting firm Bain &amp; Company after he graduated from Carleton, but left after 3 months to join a start-up that builds data sets and environments for labs developing AI models.<\/p>\n","protected":false},"author":220,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"protect_children":false,"footnotes":"","_members_access_role":[],"_members_access_error":""},"categories":[75,7089],"tags":[],"class_list":["post-44888","post","type-post","status-publish","format-standard","hentry","category-alumni","category-elsewhere"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts\/44888","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.carleton.edu\/news\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.carleton.ed